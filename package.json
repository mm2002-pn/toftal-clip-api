{
  "name": "toftal-clip-api",
  "version": "1.0.0",
  "description": "Backend API for Toftal Clip - Video Production Platform",
  "main": "dist/server.js",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "backfill:thumbnails": "ts-node --transpile-only scripts/backfill-thumbnails.ts",
    "backfill:thumbnails:dry": "ts-node --transpile-only scripts/backfill-thumbnails.ts --dry-run",
    "backfill:metadata": "ts-node --transpile-only scripts/backfill-metadata.ts",
    "backfill:metadata:dry": "ts-node --transpile-only scripts/backfill-metadata.ts --dry-run",
    "backfill:cache-control": "ts-node --transpile-only scripts/backfill-cache-control.ts",
    "backfill:cache-control:dry": "ts-node --transpile-only scripts/backfill-cache-control.ts --dry-run",
    "backfill:audio-mime": "ts-node --transpile-only scripts/backfill-audio-content-type.ts",
    "backfill:audio-mime:dry": "ts-node --transpile-only scripts/backfill-audio-content-type.ts --dry-run",
    "backfill:all": "npm run backfill:metadata && npm run backfill:thumbnails && npm run backfill:cache-control && npm run backfill:audio-mime"
  },
  "keywords": [
    "api",
    "graphql",
    "rest",
    "video",
    "production"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@google-cloud/storage": "^7.19.0",
    "@google/generative-ai": "^0.24.1",
    "@graphql-tools/merge": "^9.1.7",
    "@graphql-tools/schema": "^10.0.31",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tus/file-store": "^2.0.0",
    "@tus/gcs-store": "^2.0.0",
    "@tus/server": "^2.3.0",
    "@types/compression": "^1.8.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.2.3",
    "@types/uuid": "^10.0.0",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "graphql-tag": "^2.12.6",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "prisma": "^5.22.0",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "uuid": "^8.3.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.11",
    "jest": "^30.3.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.9"
  }
}
