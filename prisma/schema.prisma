// ==================== SUBSCRIPTION / BILLING MODELS ====================

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING_PAYMENT // checkout opened, waiting for first webhook
  TRIALING // free-trial period (gated behind feature flag)
  ACTIVE // paid, in current period
  PAST_DUE // renewal failed, in grace period
  CANCELLED // user-cancelled, access until currentPeriodEnd
  SUSPENDED // grace period exceeded — read-only access
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Plans are DB-backed and admin-editable so pricing/limits can change without
// a code release. The `prices` Json keys by currency to leave room for XAF /
// EUR / USD later — at launch we only seed XOF.
//   Shape: { "XOF": { "monthly": 19900, "yearly": 119400 }, "EUR": ... }
//   Stored as the actual transaction amount in the smallest unit accepted by
//   the local payment processor — XOF has no minor unit, so 19900 = 19 900 F.
//
// `features` is a free-form string array (e.g. ["voice_memos","ia_magic"]).
// `maxProjects` / `maxMembers` null = illimité (Agence/Entreprise).
// `isCustom` plans (Entreprise) skip self-checkout and route to a contact
// sales flow instead.
model SubscriptionPlan {
  id           String   @id @default(uuid())
  slug         String   @unique // "team", "agency", "enterprise"
  name         String // "Équipe", "Agence", "Entreprise"
  description  String?
  prices       Json // { "XOF": { monthly, yearly } }
  maxProjects  Int?     @map("max_projects")
  maxMembers   Int?     @map("max_members")
  features     String[] @default([])
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  isCustom     Boolean  @default(false) @map("is_custom")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([isActive, displayOrder])
  @@map("subscription_plans")
}

// Subscription is org-scoped at launch (Solo workspace stays free for now).
// One Subscription per Organization (1:1) — upgrade/downgrade mutates the
// existing row rather than creating a new one. trialEndsAt drives the
// TRIALING → ACTIVE transition; nextBillingAt drives the renewal cron.
model Subscription {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")
  planId         String @map("plan_id")

  billingCycle BillingCycle       @map("billing_cycle")
  currency     String             @default("XOF") // "XOF" | "EUR" | ...
  status       SubscriptionStatus @default(PENDING_PAYMENT)

  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  nextBillingAt      DateTime? @map("next_billing_at")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  payments     Payment[]

  @@index([status])
  @@index([nextBillingAt])
  @@map("subscriptions")
}

// One row per Bictorys charge attempt (initial purchase, renewal, retry).
// `bictorysChargeId` is unique → guarantees idempotence on webhook retries.
// `paymentReference` is our own opaque ID we send to Bictorys — used as the
// stable lookup key when the user returns from the hosted checkout.
model Payment {
  id             String @id @default(uuid())
  subscriptionId String @map("subscription_id")

  bictorysChargeId String? @unique @map("bictorys_charge_id")
  paymentReference String  @unique @map("payment_reference")

  amount        Int // XOF has no minor unit → 19900 means 19 900 F
  currency      String // "XOF"
  status        PaymentStatus @default(PENDING)
  paymentMethod String?       @map("payment_method") // "orange_money" | "wave" | "card" | ...
  failureReason String?       @map("failure_reason")

  // Bictorys hosted-checkout URL the user should be redirected to. Filled
  // asynchronously after the inbound /subscriptions/checkout response is
  // sent — the WAF rejects outbound calls fired while the inbound socket
  // is still open, so we return { paymentReference } immediately and let
  // the frontend poll /checkout/:reference/status until this column is
  // populated. See bictorysService.ts header for the timing details.
  checkoutUrl String? @map("checkout_url")

  createdAt         DateTime  @default(now()) @map("created_at")
  processedAt       DateTime? @map("processed_at")
  webhookReceivedAt DateTime? @map("webhook_received_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique // "invitation" | "verify_email" | "password_reset" | ...
  description String?
  subject     String
  htmlBody    String   @map("html_body") @db.Text
  textBody    String?  @map("text_body") @db.Text
  variables   String[] @default([]) // documented list, e.g. ["userName","projectTitle","link"]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model AIPromptTemplate {
  id                 String   @id @default(uuid())
  name               String   @unique // "brief_optimization" | "video_analysis" | ...
  description        String?
  model              String   @default("groq:llama-3.3-70b-versatile") // provider:model
  systemPrompt       String?  @map("system_prompt") @db.Text
  userPromptTemplate String   @map("user_prompt_template") @db.Text
  temperature        Float    @default(0.7)
  maxTokens          Int?     @map("max_tokens")
  responseFormat     String?  @map("response_format") // "json" | "text"
  variables          String[] @default([])
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("ai_prompt_templates")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// FCM device tokens for web push notifications. One row per device/browser.
// `token` is the FCM registration token (globally unique) so we can upsert by
// it — that way reinstalling on the same browser under a different account
// reassigns the token to the new user instead of duplicating rows.
model UserDeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("web") // "web" | "ios" | "android"
  userAgent  String?  @map("user_agent") @db.Text
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_device_tokens")
}
