generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  USER
  ADMIN
  CLIENT // Legacy - kept for backwards compatibility
  TALENT // Legacy - kept for backwards compatibility
}

enum ProjectStatus {
  DRAFT // Brouillon
  PENDING
  MATCHING
  IN_PROGRESS // Production (projet actif)
  REVIEW
  COMPLETED // Terminé (auto: tous livrables à 100%)
  ARCHIVED // Archivé (action manuelle)
}

enum DeliverableStatus {
  PREPARATION
  PRODUCTION
  RETOUR
  VALIDATION
  VALIDE
}

enum VersionStatus {
  PROCESSING
  NEEDS_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum AcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum FeedbackType {
  TEXT
  AUDIO
}

enum OpportunityType {
  Shorts
  YouTube_Long
  Podcast
  Miniatures
}

enum OpportunityLevel {
  Confirme
  Expert
}

enum ProjectType {
  PERSONAL
  CLIENT
}

enum ProjectRole {
  OWNER
  COLLABORATOR
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MediaResourceTag {
  RUSH
  AUDIO
  MUSIC
  LOGO
  B_ROLL
  SCRIPT
  REFERENCE
}

enum TalentTag {
  SHORT
  PODCAST
  LONG_FORM
}

enum ContentType {
  SHORT_FORM
  LONG_FORM
  PODCAST
  THUMBNAIL
}

enum OrganizationMemberRole {
  ADMIN
  MEMBER
}

enum OrganizationMemberStatus {
  ACTIVE
  PENDING
}

// ==================== MODELS ====================

model VideoFormatSpec {
  contentType ContentType @id // Unique identifier

  // Video specifications
  minWidth    Int    @map("min_width") // Ex: 1080
  minHeight   Int    @map("min_height") // Ex: 1920
  aspectRatio String @map("aspect_ratio") // Ex: "9:16", "16:9", "1:1"

  // Duration specs
  minDuration Int  @map("min_duration") // In seconds
  maxDuration Int? @map("max_duration") // null = unlimited

  // Encoding specs
  recommendedCodec   String @map("recommended_codec") // Ex: "H.264", "VP9"
  recommendedBitrate Int    @map("recommended_bitrate") // kbps

  // Metadata
  description String
  label       String // "Short Form", "Long Form", etc.
  icon        String? // Icon URL or emoji

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  deliverables   Deliverable[]
  portfolioItems PortfolioItem[]
  opportunities  Opportunity[]

  @@map("video_format_specs")
}

model User {
  id                        String        @id @default(uuid())
  email                     String        @unique
  passwordHash              String?       @map("password_hash")
  name                      String
  role                      UserRole      @default(USER)
  avatarUrl                 String?       @map("avatar_url")
  authProvider              String        @default("email") @map("auth_provider") // "email" | "google"
  firebaseUid               String?       @unique @map("firebase_uid")
  emailVerified             Boolean       @default(false) @map("email_verified")
  emailVerificationToken    String?       @map("email_verification_token")
  emailVerificationExpires  DateTime?     @map("email_verification_expires")
  passwordResetOtp          String?       @map("password_reset_otp")
  passwordResetOtpExpires   DateTime?     @map("password_reset_otp_expires")
  passwordResetToken        String?       @map("password_reset_token")
  passwordResetTokenExpires DateTime?     @map("password_reset_token_expires")
  accountStatus             AccountStatus @default(ACTIVE) @map("account_status")
  archivedAt                DateTime?     @map("archived_at")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  // Talent Mode Fields (NEW!)
  talentModeEnabled    Boolean   @default(false) @map("talent_mode_enabled")
  talentActivationDate DateTime? @map("talent_activation_date")
  talentQuestionnaire  Json?     @map("talent_questionnaire")

  // Relations
  clientProjects           Project[]                  @relation("ClientProjects")
  talentModeActivationLogs TalentModeActivationLog[]
  talentProjects           Project[]                  @relation("TalentProjects")
  ownedProjects            Project[]                  @relation("OwnedProjects")
  assignedDeliverables     Deliverable[]
  uploadedVersions         Version[]
  feedbacks                Feedback[]
  resolvedFeedbacks        Feedback[]                 @relation("ResolvedFeedbacks")
  reviews                  Review[]                   @relation("ReviewAuthor")
  talentProfile            TalentProfile?
  opportunities            Opportunity[]
  notifications            Notification[]
  workspaceMembers         WorkspaceMember[]
  ownedWorkspaces          Workspace[]
  organizationMemberships  OrganizationMember[]
  ownedOrganizations       Organization[]
  teamInvitationsSent      TeamInvitation[]
  projectMemberships       ProjectMember[]
  sentInvitations          ProjectInvitation[]
  accessRequests           AccessRequest[]            @relation("AccessRequests")
  createdPublicLinks       PublicShareLink[]          @relation("PublicShareLinks")
  createdDeliverableLinks  DeliverableShareLink[]     @relation("DeliverableShareLinks")
  transferRequestsFrom     OwnershipTransferRequest[] @relation("TransferRequestsFrom")
  transferRequestsTo       OwnershipTransferRequest[] @relation("TransferRequestsTo")
  feedbackReads            FeedbackRead[]
  feedbackReactions        FeedbackReaction[]
  auditLogs                AuditLog[]
  deviceTokens             UserDeviceToken[]

  @@map("users")
}

model Project {
  id                  String        @id @default(uuid())
  title               String
  clientId            String        @map("client_id")
  talentId            String?       @map("talent_id")
  type                ProjectType   @default(PERSONAL)
  // INVARIANT: ownerId can become an "orphan" pointer after US-TEAM-09 —
  // when a user is removed from an org, we delete their ProjectMember rows
  // on team projects but intentionally leave Project.owner_id alone (per
  // spec: "Ses vidéos et projets restent dans l'équipe sans propriétaire,
  // réattribution manuelle"). The project then has no active accessor: the
  // ex-owner has no membership row, and the team admins haven't been added
  // either. V2 will add a "reassign ownership" admin action to fix this.
  ownerId             String?       @map("owner_id")
  // NULL = personal project. Set = the project lives in this organisation's
  // team space. The org admin chooses what to put there (or it's set
  // automatically when a team member is added — see addTeamMemberToProject).
  organizationId      String?       @map("organization_id")
  status              ProjectStatus @default(DRAFT)
  startDate           DateTime?     @map("start_date")
  deadline            DateTime?
  brief               Json?
  briefCompletedAt    DateTime?     @map("brief_completed_at") // When client completed onboarding
  invitationRefusedAt DateTime?     @map("invitation_refused_at") // When client refused invitation
  aiScore             Int?          @map("ai_score")
  isArchived          Boolean       @default(false) @map("is_archived")
  archivedAt          DateTime?     @map("archived_at")
  deletedAt           DateTime?     @map("deleted_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  client           User                       @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  talent           User?                      @relation("TalentProjects", fields: [talentId], references: [id], onDelete: SetNull)
  owner            User?                      @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: SetNull)
  organization     Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deliverables     Deliverable[]
  mediaResources   MediaResource[]
  members          ProjectMember[]
  invitations      ProjectInvitation[]
  accessRequests   AccessRequest[]            @relation("AccessRequests")
  publicLinks      PublicShareLink[]
  transferRequests OwnershipTransferRequest[]

  @@index([organizationId])
  @@map("projects")
}

model Deliverable {
  id               String            @id @default(uuid())
  projectId        String            @map("project_id")
  title            String
  type             String? // Legacy - kept for backwards compatibility
  contentType      ContentType?      @map("content_type") // New unified system
  status           DeliverableStatus @default(PREPARATION)
  progress         Int               @default(0)
  assignedTalentId String?           @map("assigned_talent_id")
  acceptanceStatus AcceptanceStatus? @map("acceptance_status")
  deadline         DateTime?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  // Relations
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTalent User?                  @relation(fields: [assignedTalentId], references: [id], onDelete: SetNull)
  formatSpec     VideoFormatSpec?       @relation(fields: [contentType], references: [contentType])
  versions       Version[]
  workflowPhases WorkflowPhase[]
  mediaResources MediaResource[]
  shareLinks     DeliverableShareLink[]

  // ✅ PHASE 2: Index pour optimiser les queries
  @@index([projectId])
  @@index([assignedTalentId])
  @@map("deliverables")
}

model Version {
  id            String        @id @default(uuid())
  deliverableId String        @map("deliverable_id")
  versionNumber Int           @map("version_number")
  videoUrl      String        @map("video_url")
  // JPEG preview frame (generated async after upload) — displayed as
  // <video poster> and in list cards for instant first paint.
  thumbnailUrl  String?       @map("thumbnail_url")
  description   String?
  status        VersionStatus @default(NEEDS_REVIEW)
  uploadedById  String?       @map("uploaded_by_id")
  aiAnalysis    Json?         @map("ai_analysis")

  // Video metadata
  metadata             Json? // { width, height, duration, quality, fps, bitrate }
  alternativeQualities Json? @map("alternative_qualities") // { "2K": "url", "1080p": "url" }

  // File size in bytes (backfilled from GCS; populated on upload going forward).
  fileSize BigInt? @map("file_size")

  uploadedAt DateTime @default(now()) @map("uploaded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  deliverable    Deliverable           @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  uploadedBy     User?                 @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  feedbacks      Feedback[]
  downscaleJobs  VersionDownscaleJob[]

  // ✅ PHASE 2: Index pour optimiser les queries
  @@index([deliverableId])
  @@index([uploadedById])
  @@map("versions")
}

// One row per (version, target-quality) pair. Lets us run ffmpeg in an
// out-of-band Cloud Run Job instead of on the HTTP thread and keeps the
// dedup atomic — a UNIQUE(version_id, quality) means N concurrent
// requests for the same downscale only ever spawn ONE worker.
//
//   PROCESSING → ffmpeg currently running (or zombie if startedAt > 1h)
//   DONE       → resultUrl is the GCS URL and Version.alternativeQualities
//                also mirrors it for cheap reads
//   FAILED     → error has the wrapped ffmpeg/upload message; callers
//                can re-enqueue via POST .../downscale?retry=1
enum DownscaleJobStatus {
  PROCESSING
  DONE
  FAILED
}

model VersionDownscaleJob {
  id                  String              @id @default(uuid())
  versionId           String              @map("version_id")
  quality             String              // '720p' | '1080p' | '2K' | '4K' | 'SD'
  status              DownscaleJobStatus  @default(PROCESSING)
  cloudRunExecutionId String?             @map("cloud_run_execution_id")
  resultUrl           String?             @map("result_url")
  error               String?
  startedAt           DateTime            @default(now()) @map("started_at")
  finishedAt          DateTime?           @map("finished_at")

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, quality], name: "version_quality_unique")
  @@index([status, startedAt])
  @@map("version_downscale_jobs")
}

model WorkflowPhase {
  id            String   @id @default(uuid())
  deliverableId String   @map("deliverable_id")
  title         String
  status        String   @default("pending")
  assignedTo    String   @default("CLIENT") @map("assigned_to")
  orderIndex    Int      @default(0) @map("order_index")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  deliverable Deliverable    @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  tasks       WorkflowTask[]

  @@map("workflow_phases")
}

model WorkflowTask {
  id         String   @id @default(uuid())
  phaseId    String   @map("phase_id")
  title      String
  completed  Boolean  @default(false)
  assignedTo String?  @map("assigned_to")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  phase WorkflowPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@map("workflow_tasks")
}

model Feedback {
  id             String       @id @default(uuid())
  versionId      String       @map("version_id")
  authorId       String?      @map("author_id") // Nullable for guest comments
  guestName      String?      @map("guest_name") // Guest commenter name
  guestEmail     String?      @map("guest_email") // Guest commenter email
  rawText        String       @map("raw_text")
  structuredText String?      @map("structured_text")
  type           FeedbackType @default(TEXT)
  replyingToId   String?      @map("replying_to_id")

  // Voice note fields (WhatsApp-style)
  audioUrl      String? @map("audio_url") // URL of audio file in GCS
  audioDuration Float?  @map("audio_duration") // Duration in seconds

  // File attachments (WhatsApp-style) - array of {name, url, type, size}
  attachments Json? @default("[]") // JSON array of attachment objects

  // Video annotation fields - position on video where comment was made
  annotationX Float? @map("annotation_x") // X coordinate (0-100%) of annotation point
  annotationY Float? @map("annotation_y") // Y coordinate (0-100%) of annotation point

  // Vimeo-style video review features
  timestamp    Float?    @map("timestamp") // Video position in seconds when comment was made
  resolved     Boolean   @default(false) // Comment resolved status
  resolvedAt   DateTime? @map("resolved_at") // When the comment was resolved
  resolvedById String?   @map("resolved_by_id") // Who resolved the comment

  // Drawing annotations (Timeliner.io style) - array of DrawingShape objects
  drawings Json? @default("[]") // JSON array of drawing shapes

  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at") // WhatsApp-style: shows "Modifié" when not null

  // Relations
  version       Version            @relation(fields: [versionId], references: [id], onDelete: Cascade)
  author        User?              @relation(fields: [authorId], references: [id], onDelete: Cascade) // Optional for guests
  resolvedBy    User?              @relation("ResolvedFeedbacks", fields: [resolvedById], references: [id], onDelete: SetNull)
  revisionTasks RevisionTask[]
  replyingTo    Feedback?          @relation("FeedbackReplies", fields: [replyingToId], references: [id], onDelete: SetNull)
  replies       Feedback[]         @relation("FeedbackReplies")
  reads         FeedbackRead[]
  reactions     FeedbackReaction[]

  // ✅ PHASE 2: Index pour optimiser les queries
  @@index([versionId])
  @@index([authorId])
  @@map("feedbacks")
}

// WhatsApp-style group read receipts (2 blue checkmarks when read by all recipients)
// WhatsApp-style read receipts. Supports both authenticated readers
// (userId set, guest fields null) and guests reading via a share link
// (userId null, guestEmail set). Same dual-identity pattern as
// FeedbackReaction.
model FeedbackRead {
  id         String   @id @default(uuid())
  feedbackId String   @map("feedback_id")
  userId     String?  @map("user_id")
  guestEmail String?  @map("guest_email")
  readAt     DateTime @default(now()) @map("read_at")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Postgres treats NULLs as DISTINCT in UNIQUE, so this only
  // enforces uniqueness for authenticated readers. Guest uniqueness
  // on (feedbackId, guestEmail) is enforced by the controller via
  // upsert-style findFirst-then-create.
  @@unique([feedbackId, userId])
  @@index([feedbackId])
  @@index([userId])
  @@index([feedbackId, guestEmail])
  @@map("feedback_reads")
}

// Emoji reactions on feedback (WhatsApp/Linear-style).
// Supports both authenticated users (userId set, guest fields null)
// and guests reacting through a share link (userId null, guestEmail
// set). Exactly one of these two identity columns is populated per
// row — the controllers enforce that.
model FeedbackReaction {
  id         String   @id @default(uuid())
  feedbackId String   @map("feedback_id")
  userId     String?  @map("user_id")
  guestEmail String?  @map("guest_email")
  guestName  String?  @map("guest_name")
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Postgres treats NULL values as DISTINCT in a UNIQUE constraint by
  // default, so this only enforces uniqueness on (feedbackId, userId)
  // for authenticated reactions — exactly what we want. Guest
  // uniqueness on (feedbackId, guestEmail) is enforced by the
  // controller (findFirst-then-act) since Prisma doesn't expose
  // partial unique indexes for compound keys without raw SQL.
  @@unique([feedbackId, userId])
  @@index([feedbackId])
  @@index([userId])
  @@index([feedbackId, guestEmail])
  @@map("feedback_reactions")
}

model RevisionTask {
  id          String   @id @default(uuid())
  feedbackId  String   @map("feedback_id")
  description String
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("revision_tasks")
}

model MediaResource {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  deliverableId String?  @map("deliverable_id")
  name          String
  url           String
  type          String   @default("FOLDER")
  category      String?
  tags          String[] @default([]) // Tags for organization (RUSH, AUDIO, MUSIC, etc.)
  addedBy       String?  @map("added_by")
  // File size in bytes (backfilled from GCS; populated on upload going forward).
  fileSize      BigInt?  @map("file_size")
  dateAdded     DateTime @default(now()) @map("date_added")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)

  @@map("media_resources")
}

// ==================== TALENT MODELS ====================

model TalentProfile {
  id                String      @id @default(uuid())
  userId            String      @unique @map("user_id")
  bio               String?
  tagline           String? // Phrase d'accroche professionnelle
  location          String?
  languages         String[]    @default([])
  skills            String[]    @default([]) // Logiciels maîtrisés (Premiere, DaVinci, etc.)
  expertise         String[]    @default([]) // Domaines d'expertise (Color Grading, Motion Design, etc.)
  tags              TalentTag[] @default([]) // Tags prédéfinis (Short, Podcast, Long Form)
  videoType         String?     @map("video_type")
  responseTime      String?     @map("response_time")
  rating            Float       @default(0)
  reviewsCount      Int         @default(0) @map("reviews_count")
  completedProjects Int         @default(0) @map("completed_projects")
  startingPrice     String?     @map("starting_price")
  verified          Boolean     @default(false)
  coverImage        String?     @map("cover_image")

  // Nouveaux champs pour portfolio professionnel
  socialLinks Json? @map("social_links") // { youtube, vimeo, instagram, tiktok, website, linkedin }
  stats       Json? // { totalViews, yearsExperience, clientsServed }

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio PortfolioItem[]
  reviews   Review[]
  packages  Package[]

  @@map("talent_profiles")
}

model PortfolioItem {
  id          String       @id @default(uuid())
  talentId    String       @map("talent_id")
  title       String
  thumbnail   String
  videoUrl    String?      @map("video_url") // URL de la vidéo (YouTube, Vimeo, etc.)
  type        String? // Legacy - kept for backwards compatibility
  tag         String? // Legacy - Tag: SHORT, PODCAST, LONG_FORM
  contentType ContentType? @map("content_type") // New unified system
  views       String?
  duration    String? // "12:34"
  orderIndex  Int          @default(0) @map("order_index") // Pour trier
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  talent     TalentProfile    @relation(fields: [talentId], references: [id], onDelete: Cascade)
  formatSpec VideoFormatSpec? @relation(fields: [contentType], references: [contentType])

  @@map("portfolio_items")
}

model Review {
  id        String   @id @default(uuid())
  talentId  String   @map("talent_id")
  authorId  String   @map("author_id")
  rating    Int
  text      String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  talent TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  author User          @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Package {
  id          String   @id @default(uuid())
  talentId    String   @map("talent_id")
  name        String
  price       String
  description String?
  features    String[] @default([])
  isPopular   Boolean  @default(false) @map("is_popular")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  talent TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@map("packages")
}

// ==================== OPPORTUNITY MODELS ====================

model Opportunity {
  id             String            @id @default(uuid())
  title          String
  clientId       String            @map("client_id")
  clientName     String?           @map("client_name")
  clientAvatar   String?           @map("client_avatar")
  type           OpportunityType? // Legacy - kept for backwards compatibility
  contentType    ContentType?      @map("content_type") // New unified system
  volume         String?
  duration       String?
  style          String?
  deadline       String?
  level          OpportunityLevel?
  description    String?
  isVerified     Boolean           @default(false) @map("is_verified")
  isRecurring    Boolean           @default(false) @map("is_recurring")
  whatsappNumber String?           @map("whatsapp_number")
  createdAt      DateTime          @default(now()) @map("created_at")

  // Relations
  client       User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formatSpec   VideoFormatSpec? @relation(fields: [contentType], references: [contentType])
  applications Application[]

  @@map("opportunities")
}

model Application {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  talentId      String   @map("talent_id")
  message       String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("applications")
}

// ==================== STUDIO MODELS ====================

model Studio {
  id             String   @id @default(uuid())
  name           String
  location       String?
  pricePerHour   String?  @map("price_per_hour")
  rating         Float    @default(0)
  thumbnail      String?
  gallery        String[] @default([])
  tags           String[] @default([])
  description    String?
  whatsappNumber String?  @map("whatsapp_number")
  features       String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("studios")
}

// ==================== NOTIFICATION MODELS ====================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ==================== WORKSPACE MODELS ====================

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now()) @map("joined_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ==================== ORGANIZATION MODELS ====================

// Workspace status — gates access to the org's projects/team UI.
//   DRAFT     : just created, awaiting initial payment. Hidden from the user
//               until the webhook flips it. Auto-cleaned after 24h if no pay.
//   ACTIVE    : paid (or trialing), full access.
//   SUSPENDED : payment failed past grace period OR a pre-billing org that
//               hasn't subscribed yet — projects are read-only, banner asks
//               the admin to renew.
enum OrganizationStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  logoUrl     String?            @map("logo_url")
  createdById String             @map("created_by_id")
  status      OrganizationStatus @default(DRAFT)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Relations
  createdBy    User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  invitations  TeamInvitation[]
  projects     Project[]
  subscription Subscription?

  @@index([status])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(uuid())
  organizationId String                   @map("organization_id")
  userId         String                   @map("user_id")
  role           OrganizationMemberRole   @default(MEMBER)
  status         OrganizationMemberStatus @default(ACTIVE)
  jobLabel       String?                  @map("job_label")
  joinedAt       DateTime                 @default(now()) @map("joined_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model TeamInvitation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  invitedById    String           @map("invited_by_id")
  email          String
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  refusedAt      DateTime?        @map("refused_at")
  refusalReason  String?          @map("refusal_reason") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@map("team_invitations")
}

// ==================== PROJECT COLLABORATION MODELS ====================

model ProjectMember {
  id          String      @id @default(uuid())
  projectId   String      @map("project_id")
  userId      String      @map("user_id")
  role        ProjectRole @default(COLLABORATOR)
