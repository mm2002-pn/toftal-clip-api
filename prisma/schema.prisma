  project Project @relation("AccessRequests", fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("AccessRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([status])
  @@map("access_requests")
}

